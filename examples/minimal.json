{
  "version": 1,
  "instance": "minimal",
  "ports": {
    "wan": { "kind": "l2", "device": "eth0" },
    "lan": { "kind": "l2", "device": "eth1" }
  },
  "interfaces": {
    "wan0": { "port": "wan", "address": "dhcp" },
    "lan0": { "port": "lan", "address": "10.0.0.1/24" }
  },
  "dhcp": [
    { "iface": "lan0", "pool": "10.0.0.100-10.0.0.200" }
  ],
  "firewall": {
    "default_in": "accept",
    "default_forward": "accept",
    "default_out": "accept"
  }
}
